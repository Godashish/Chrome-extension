{
  "manifest_version": 3,
  "name": "Invoice Extractor",
  "version": "0.2.0",
  "description": "Paste invoice or receipt text and get structured, trackable payment records.",
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"]
}
